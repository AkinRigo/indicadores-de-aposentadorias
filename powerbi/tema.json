{
  "name": "Concede - Painel de Beneficios",
  "dataColors": ["#118DFF", "#0F6CBD", "#A19F9D", "#E66C37", "#744EC2", "#D9B300", "#A4262C", "#00A88F"],
  "foreground": "#252423",
  "background": "#FFFFFF",
  "tableAccent": "#118DFF",
  "good": "#107C10",
  "neutral": "#D9B300",
  "bad": "#A4262C",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#252423" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#323130" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 32, "color": "#252423" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F2F1" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F3F2F1" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1DFDD" } }, "radius": 4 }]
      }
    },
    "barChart": {
      "*": {
        "labels": [{ "show": true, "labelDisplayUnits": 1 }],
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "categoryAxis": [{ "showAxisTitle": false }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [{ "show": true, "labelDisplayUnits": 1 }],
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "categoryAxis": [{ "showAxisTitle": false }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "labelDisplayUnits": 1 }]
      }
    }
  }
}
